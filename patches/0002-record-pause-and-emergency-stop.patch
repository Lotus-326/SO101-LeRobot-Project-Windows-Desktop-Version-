+    # ---- LOCAL PATCH: 暂停 / 急停 ------------------------------------------
+    # 为什么加：录制 50 条期间难免遇到「舵机过载发烫」「方块被碰跑」
+    # 「有人进来打断」这类情况。原生只有 ←（丢弃重录）和 ESC（结束会话），
+    # 缺一个「先停下来处理，处理完接着录同一条」的手段。
+    #   · pause=Toggled by SPACE：暂停录制新帧，但主从跟随继续（见 lerobot_record.py）
+    #   · emergency_stop=Triggered by 'x'：丢弃当前条 + 结束会话 + 收尾失能力矩
+    # ------------------------------------------------------------------------
+    events["pause"] = False
+    events["emergency_stop"] = False
 
     if is_headless():
         logging.warning(
@@ -159,6 +168,27 @@ def init_keyboard_listener():
                 print("Escape key pressed. Stopping data recording...")
                 events["stop_recording"] = True
                 events["exit_early"] = True
+            # ---- LOCAL PATCH: 空格 = 暂停/继续 ---------------------------------
+            elif key == keyboard.Key.space:
+                events["pause"] = not events.get("pause", False)
+                if events["pause"]:
+                    print(
+                        "\n>>> 已暂停（PAUSED）：不再录制新帧，但主从跟随继续，"
+                        "所以恢复时从臂不会跳。再按【空格】继续。\n"
+                    )
+                else:
+                    print("\n>>> 已继续（RESUMED）：接着录同一条，暂停这段时间不会被记进去。\n")
+            # ---- LOCAL PATCH: x = 急停（丢弃当前条 + 结束会话 + 失能力矩）-------
+            elif getattr(key, "char", None) in ("x", "X"):
+                print(
+                    "\n>>> 急停（EMERGENCY STOP）：丢弃当前 episode、结束会话、"
+                    "收尾时释放力矩。\n"
